{
  // 部署：node scripts/build.mjs && npx wrangler@4 deploy（靜態只上傳 dist/ 白名單；/api/* 先進 Worker）
  "name": "buildingyourmemory",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "buildingyourmemory", "database_id": "b4841d70-2604-46cb-b71d-043d751839c2" }
  ],
  "vars": { "ENV": "prod", "APP_ORIGIN": "https://buildingyourmemory.gpttotaychat.workers.dev" },
  // DEVICE_SECRET 用 wrangler secret put；本機在 .dev.vars
  "observability": { "enabled": true }
}
