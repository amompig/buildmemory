{
  "_meta": {
    "version": "2026-10-21.2",
    "blueprint_version": 2,
    "note": "台北 12 棟地標（精選 tier）。blueprint v2：一棟 = 多個 block，各自有佔格偏移、尺寸、層數、屋頂；joins 說明 block 之間怎麼接。size 可為任意 w×d（1–3）。photo_ref 只做觀察，不隨 App 發布。色票吸附到 palette.json 家族，家族外新色列在 _new_colors。契約變更見 docs/blueprint_v2_proposal.md。",
    "block_fields": {
      "id": "block 名，joins 用",
      "at": "[c, r] 相對錨點格（錨點 = 最小 r、最小 c）的偏移，單位格；可為小數（塔樓置中用）",
      "on": "疊在哪個 block 上（stack）；有 on 時 at 相對該 block 的原點",
      "w / d": "佔格寬 (c 方向) / 深 (r 方向)，單位格，可為小數",
      "floors / floorH": "層數 × 層高（格單位）；h = floors × floorH。courtyard 用 floors 0 floorH 0.1",
      "roof": "flat | gable | hip | hip2（雙層）| swallowtail | swallowtail2 | dome | pagoda | spire",
      "window / windowCols / door / porch / special / extras": "同 v1",
      "color": "可覆寫 wall / roof / door / accent（例如石基）"
    },
    "join_types": {
      "shared_wall": "相鄰、共用一面牆，bake 時合併面、不畫內牆",
      "stack": "a 疊在 b 的屋頂上（塔樓）；b 在 a 投影處改 flat",
      "courtyard": "a 是中庭（h≈0，地面色），b 是圍它的 block 們",
      "colonnade": "a 與 b 之間用柱廊相接（柱列、無牆）"
    },
    "rot": "rot 旋轉整棟（所有 block 的 at / w / d 一起轉）；rot 1 / 3 時 size 的 w、d 對調，佔格也跟著變——這是 v1 契約的變更點",
    "enums": {
      "roof": ["flat", "gable", "hip", "hip2", "swallowtail", "swallowtail2", "dome", "pagoda", "spire"],
      "window": ["plain", "arch", "round", "koshi", "grille", "shutter"],
      "door": ["plain", "arch", "double", "noren"],
      "porch": ["none", "eave", "columns", "arcade", "stilts"],
      "special": ["none", "tower", "lantern", "windcatcher", "timber"]
    },
    "_new_colors": {
      "#B8503A": "深紅磚（北門、紅樓、總統府、監察院、龍山寺、圓山）",
      "#7F9A8C": "銅綠圓頂（博物館、監察院）",
      "#7A9E99": "101 玻璃綠",
      "#C9A24A": "圓山金瓦",
      "#4A6FA5": "中正紀念堂藍瓦",
      "#8E8A80": "城門 / 廟宇石基",
      "#CFC7B4": "迪化街洗石子",
      "#9FBFA6": "中庭草地（= three.scene.tile 微調）"
    }
  },
